diff --git a/board/rockchip/rk356x/fs-overlay/etc/init.d/S49weston b/board/rockchip/rk356x/fs-overlay/etc/init.d/S49weston
new file mode 100755
index 00000000..10cad42a
--- /dev/null
+++ b/board/rockchip/rk356x/fs-overlay/etc/init.d/S49weston
@@ -0,0 +1,53 @@
+#!/bin/sh -e
+### BEGIN INIT INFO
+# Provides:          weston
+# Required-Start:    mountvirtfs
+# Required-Stop:
+# Should-Start:
+# Should-Stop:
+# Default-Start:     2 3 4 5
+# Default-Stop:      0 1 6
+# Short-Description: Linux weston daemon
+### END INIT INFO
+
+PATH="/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
+
+# Load default env variables from profiles(e.g. /etc/profile.d/weston.sh)
+. /etc/profile
+
+start_weston()
+{
+	# /usr/bin/weston&
+}
+
+stop_weston()
+{
+	# killall weston
+}
+
+case "$1" in
+	start)
+		echo -n "starting weston... "
+		start_weston
+		echo "done."
+		;;
+	stop)
+		echo -n "stoping weston... "
+		stop_weston || true
+		echo "done."
+		;;
+	restart|reload)
+		echo -n "stoping weston... "
+		stop_weston && sleep .3
+		echo "done."
+
+		echo -n "starting weston... "
+		start_weston
+		echo "done."
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+esac
+
+exit 0
diff --git a/board/rockchip/rk356x/fs-overlay/etc/init.d/S60aicam b/board/rockchip/rk356x/fs-overlay/etc/init.d/S60aicam
new file mode 100755
index 00000000..d0c12660
--- /dev/null
+++ b/board/rockchip/rk356x/fs-overlay/etc/init.d/S60aicam
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+case "$1" in
+    start)
+        echo "Starting ai-cam-ui-widget..."
+        /root/ai-cam-ui-widget --platform linuxfb &
+        ;;
+    stop)
+        echo "Stopping ai-cam-ui-widget..."
+        killall ai-cam-ui-widget
+        ;;
+    restart)
+        $0 stop
+        sleep 1
+        $0 start
+        ;;
+    *)
+        echo "Usage: $0 {start|stop|restart}"
+        exit 1
+        ;;
+esac
+
+exit 0
diff --git a/board/rockchip/rk356x/fs-overlay/etc/profile b/board/rockchip/rk356x/fs-overlay/etc/profile
new file mode 100755
index 00000000..dff03d9b
--- /dev/null
+++ b/board/rockchip/rk356x/fs-overlay/etc/profile
@@ -0,0 +1,29 @@
+export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
+
+if [ "$PS1" ]; then
+  if [ "$BASH" ]; then
+    # The file bash.bashrc already sets the default PS1.
+    # PS1='\h:\w\$ '
+    if [ -f /etc/bash.bashrc ]; then
+      . /etc/bash.bashrc
+    fi
+  else
+    if [ "`id -u`" -eq 0 ]; then
+      PS1='# '
+    else
+      PS1='$ '
+    fi
+  fi
+fi
+
+export EDITOR='/bin/vi'
+
+# Source configuration files from /etc/profile.d
+for i in /etc/profile.d/*.sh ; do
+	if [ -r "$i" ]; then
+		. $i
+	fi
+done
+unset i
+
+export QT_QPA_PLATFORM=linuxfb
