+	fw_checksum <<= 8;
+	fw_checksum |= pBuf[10];
+	fw_checksum <<= 8;
+	fw_checksum |= pBuf[9];
+	fw_checksum <<= 8;
+	fw_checksum |= pBuf[8];
+
+	HYN_INFO("the updating firmware:project_id:0x%04x,ic type:0x%04x,fw_version:0x%x,checksum:0x%x\n",
