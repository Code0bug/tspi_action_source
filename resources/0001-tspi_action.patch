+	ret = cst3xx_i2c_read_register(client, buf, 3);
+	if (ret < 0)  return -1;
+	
+	if (buf[0] != 0xA8)
+	{
+        HYN_DEBUG("cst32xx_bootloader_enter detect 0xA8,buf[0]=%d.\n", buf[0]);	
+		return -1;
+	}
+			
+	mdelay(2);
+	buf[0] = 0xA0;
+	buf[1] = 0x01;
+	buf[2] = 0x00;
+	ret = cst3xx_i2c_write(client, buf, 3);
+	if (ret < 0)  return -1;
+		
+	HYN_FUNC_EXIT();
+	return 0;
