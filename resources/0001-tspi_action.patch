+static int cst92xx_boot_update_fw(struct i2c_client *client)
+{
+	int ret;
+	
+	HYN_FUNC_ENTER();
+
+	if(hyn_ts_data->apk_upgrade_flag==0)
+		ret = cst92xx_update_judge(hyn_ts_data->p_hynitron_upgrade_firmware, 1);
