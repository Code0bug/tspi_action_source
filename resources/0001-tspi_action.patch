+		return -1;
+	}
+	hyn_ts_data->fw_updating=0;
+
+    mdelay(50);
+
+	ret = cst3xx_firmware_info(client);
+	if (ret < 0) {
+		HYN_ERROR(" after update read version and checksum fail.\n");
+		return -1;
+	}
+
+	HYN_FUNC_EXIT();
+	return 0;
