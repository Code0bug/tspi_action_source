+		i2c_buf[0] = 0xA0;
+		i2c_buf[1] = 0x05;
+		ret = cst3xx_i2c_read_register(client, i2c_buf, 1);
+		//if (ret < 0)
+		//	goto error_out;
+	
+		if (i2c_buf[0] == 0x55)
+			break;
+
+		mdelay(10);
+		
+	}
+	if(k==200) 
+		goto error_out;
+		
+	
+	i2c_buf[0] = 0xA0;
+	i2c_buf[1] = 0x03;
+	i2c_buf[2] = 0x00;
+	ret = cst3xx_i2c_write(client, i2c_buf, 3);
+	if (ret < 0)
+		goto error_out;
+
+	mdelay(8);
+
+	if(i2c_buf){
+		kfree(i2c_buf);
+		i2c_buf = NULL;
+	}
+
+	return 0;
+
+error_out:
+	if(i2c_buf){
+		kfree(i2c_buf);
+		i2c_buf = NULL;
+	}
+	return -1;
+}
