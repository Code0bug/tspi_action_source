####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ai-cam-ui-widget/bin || mkdir -p $(INSTALL_ROOT)/opt/ai-cam-ui-widget/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/ai-cam-ui-widget/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/ai-cam-ui-widget/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ai-cam-ui-widget/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

