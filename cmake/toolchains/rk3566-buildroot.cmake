# Usage: -DBUILDROOT_HOST_DIR=/path/to/buildroot/output/rockchip_rk3566/host
set(BUILDROOT_HOST_DIR "$ENV{BUILDROOT_HOST_DIR}" CACHE PATH "Buildroot host directory")
if(NOT BUILDROOT_HOST_DIR)
    message(FATAL_ERROR "Set BUILDROOT_HOST_DIR to the Buildroot output/rockchip_rk3566/host directory")
endif()
get_filename_component(BUILDROOT_HOST_DIR "${BUILDROOT_HOST_DIR}" ABSOLUTE)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT "${BUILDROOT_HOST_DIR}/aarch64-buildroot-linux-gnu/sysroot")
set(CMAKE_C_COMPILER "${BUILDROOT_HOST_DIR}/bin/aarch64-buildroot-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${BUILDROOT_HOST_DIR}/bin/aarch64-buildroot-linux-gnu-g++")
foreach(required IN ITEMS "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${CMAKE_SYSROOT}/usr/include")
    if(NOT EXISTS "${required}")
        message(FATAL_ERROR "Missing SDK component: ${required}")
    endif()
endforeach()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES BUILDROOT_HOST_DIR)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# Keep host .pc files out of cross-compilation, including inherited search paths.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
