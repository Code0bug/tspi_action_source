#!/bin/sh

case "$1" in
    start)
        echo "Starting ai-cam-ui-widget..."
        /root/ai-cam-ui-widget --platform linuxfb &
        ;;
    stop)
        echo "Stopping ai-cam-ui-widget..."
        killall ai-cam-ui-widget
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
